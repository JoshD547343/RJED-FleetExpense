@page
@model RJED_FleetExpense.Pages.DashboardModel

@{
    ViewData["Title"] = "Super Admin Dashboard";
}

<div class="container-fluid py-4">
    <h2 class="mb-4 fw-bold text-primary">Super Admin Dashboard</h2>
    <p class="text-muted mb-4">System overview, user management, and global configuration</p>

    <!-- Quick Stats Cards -->
    <div class="row">
        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon-shape bg-primary text-white rounded p-3 me-3">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-0">Total Users</h6>
                            <h4 class="fw-bold">@ViewBag.TotalUsers</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon-shape bg-success text-white rounded p-3 me-3">
                            <i class="bi bi-currency-dollar fs-4"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-0">Expenses (This Month)</h6>
                            <h4 class="fw-bold">@ViewBag.TotalExpensesThisMonth.ToString("N2")</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon-shape bg-warning text-white rounded p-3 me-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-0">Pending Approvals</h6>
                            <h4 class="fw-bold">@ViewBag.PendingApprovals</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon-shape bg-info text-white rounded p-3 me-3">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                        <div>
                            <h6 class="card-title mb-0">Active Departments</h6>
                            <h4 class="fw-bold">@ViewBag.ActiveDepartments</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity & Quick Actions -->
    <div class="row mt-4">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Recent System Activity (Audit Log)</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">New user 'juan.dela.cruz' registered – 10 min ago</li>
                        <li class="list-group-item">Expense #EXP-0456 rejected by Supervisor – 45 min ago</li>
                        <li class="list-group-item">Workflow rule updated by Super Admin – 2 hours ago</li>
                        <li class="list-group-item">Security policy changed – 3 hours ago</li>
                        <!-- Load real logs from DB here -->
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">System Alerts</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning mb-2">3 expenses pending > 7 days</div>
                    <div class="alert alert-info mb-2">Fuel price API limit approaching</div>
                    <div class="alert alert-danger mb-0">2 users with failed login attempts</div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("Index", "Users", new { area = "SuperAdmin" })" class="btn btn-outline-primary w-100 mb-2">Manage Users & Roles</a>
                    <a href="#" class="btn btn-outline-primary w-100 mb-2">Configure Workflow Rules</a>
                    <a href="#" class="btn btn-outline-primary w-100 mb-2">View Full Audit Log</a>
                    <a href="#" class="btn btn-outline-danger w-100">System Security Settings</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Optional: Add Chart.js for real charts later -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> -->
}