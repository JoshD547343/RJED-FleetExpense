@page
@model RJED_FleetExpense.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    ViewData["HideSidebar"] = true;
    var errorMsg = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage ?? string.Empty;
    bool isPermanent = errorMsg.Contains("permanently locked");
    bool isTimedLock = !isPermanent &&
                       (errorMsg.Contains("Try again in") ||
                        errorMsg.Contains("locked for"));
    bool isWrongPass = errorMsg.Contains("attempt(s) remaining");
    bool isInactive = errorMsg.Contains("deactivated");
    bool isGenericFail =    
        !isPermanent &&
        !isTimedLock &&
        !isWrongPass &&
        !isInactive &&
        errorMsg.Length > 0;
    int attemptsLeft = 0;
    int totalPips = 3;
    if (isWrongPass)
    {
        var match = System.Text.RegularExpressions.Regex.Match(errorMsg, @"(\d+) attempt");
        if (match.Success)
        {
            int.TryParse(match.Groups[1].Value, out attemptsLeft);
        }
    }
    bool formDisabled = isPermanent || isTimedLock;
}
<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: #333;
    }

    .login-page-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
    }

    .login-card {
        width: 100%;
        max-width: 480px;
        background: rgba(255, 255, 255, 0.98);
        border-radius: 1rem;
        padding: 2.2rem 2rem;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.20);
    }

    .login-header {
        text-align: center;
        margin-bottom: 1.8rem;
    }

    .logo-img {
        max-width: 200px;
        margin-bottom: 1rem;
    }

    .login-subtitle {
        font-size: 0.95rem;
        color: #6b7280;
    }

    .form-floating {
        margin-bottom: 1.3rem;
    }

    .form-control {
        border-radius: 0.7rem;
        padding: 1.5rem 1rem 0.6rem;
        height: calc(3.4rem + 2px);
    }

        .form-control:focus {
            border-color: #4caf50;
            box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.15);
        }

        .form-control:disabled {
            background-color: #f5f5f5;
            color: #9e9e9e;
            cursor: not-allowed;
        }

    .btn-login {
        background-color: #4caf50;
        border: none;
        border-radius: 0.7rem;
        padding: 0.85rem;
        font-size: 1.05rem;
        font-weight: 600;
        transition: 0.25s ease;
    }

        .btn-login:hover:not(:disabled) {
            background-color: #43a047;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(76, 175, 80, 0.3);
        }

        .btn-login:disabled {
            background-color: #9e9e9e !important;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
            opacity: 1;
        }

    .alert-login {
        border-radius: 0.7rem;
        padding: 0.85rem 1rem;
        margin-bottom: 1.2rem;
        font-size: 0.92rem;
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
    }

    .alert-icon {
        font-size: 1.15rem;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .alert-warning-custom {
        background-color: #fff8e1;
        border: 1px solid #ffe082;
        color: #7a5800;
    }

    .alert-danger-custom {
        background-color: #ffebee;
        border: 1px solid #ef9a9a;
        color: #b71c1c;
    }

    .alert-permanent-custom {
        background-color: #fce4ec;
        border: 1px solid #f48fb1;
        color: #880e4f;
    }

    .attempt-pips {
        display: flex;
        gap: 7px;
        margin-top: 8px;
    }

    .pip {
        width: 11px;
        height: 11px;
        border-radius: 50%;
    }

        .pip.used {
            background-color: #ef5350;
        }

        .pip.empty {
            background-color: #e0e0e0;
            border: 1px solid #bdbdbd;
        }

    .lockout-timer {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        color: #b71c1c;
        letter-spacing: 0.08em;
        margin: 6px 0 2px;
        font-variant-numeric: tabular-nums;
    }

    .timer-label {
        font-size: 0.78rem;
        text-align: center;
        color: #c62828;
    }

    .page-footer {
        position: fixed;
        bottom: 10px;
        width: 100%;
        text-align: center;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.8);
    }
    @@media (max-width: 576px) {
        .login-card

    {
        padding: 1.8rem 1.4rem;
    }

    .logo-img {
        max-width: 160px;
    }

    }
</style>
<div class="login-page-wrapper">
    <div class="login-card">
        <div class="login-header">
            <img src="~/images/logo.png"
                 alt="RJED Fleet Expense"
                 class="logo-img" />
            <p class="login-subtitle">
                RJED: Fleet Expense Tracking & Management
            </p>
        </div>

        @if (isPermanent)
        {
            <div class="alert-login alert-permanent-custom">
                <div class="alert-icon">🔒</div>
                <div>
                    <strong>Account Permanently Locked</strong><br />
                    @errorMsg
                </div>
            </div>
        }
        @if (isTimedLock)
        {
            <div class="alert-login alert-danger-custom">
                <div class="alert-icon">⏳</div>
                <div class="w-100">
                    <strong>Account Temporarily Locked</strong>
                    <div id="lockTimer" class="lockout-timer">
                        0:00
                    </div>
                    <div class="timer-label">
                        Please wait before trying again.
                    </div>
                </div>
            </div>
        }
        @if (isWrongPass)
        {
            <div class="alert-login alert-warning-custom">
                <div class="alert-icon">⚠️</div>
                <div>
                    <strong>Invalid Password</strong><br />
                    @errorMsg
                    <div class="attempt-pips">
                        @for (int i = 0; i < totalPips; i++)
                        {
                            if (i < (totalPips - attemptsLeft))
                            {
                                <div class="pip used"></div>
                            }
                            else
                            {
                                <div class="pip empty"></div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
        @if (isInactive)
        {
            <div class="alert-login alert-danger-custom">
                <div class="alert-icon">🚫</div>
                <div>
                    <strong>Account Inactive</strong><br />
                    @errorMsg
                </div>
            </div>
        }
        @if (isGenericFail)
        {
            <div class="alert-login alert-danger-custom">
                <div class="alert-icon">❌</div>
                <div>
                    @errorMsg
                </div>
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       placeholder="name@example.com"
                       autofocus
                       disabled="@formDisabled" />
                <label asp-for="Input.Email">
                    Email address
                </label>
                <span asp-validation-for="Input.Email"
                      class="text-danger small">
                </span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Password"
                       disabled="@formDisabled" />
                <label asp-for="Input.Password">
                    Password
                </label>
                <span asp-validation-for="Input.Password"
                      class="text-danger small">
                </span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe"
                       class="form-check-input"
                       type="checkbox"
                       disabled="@formDisabled" />
                <label asp-for="Input.RememberMe"
                       class="form-check-label">
                    Remember me
                </label>
            </div>
            <button type="submit"
                    class="btn btn-login w-100 text-white"
                    id="loginBtn"
                    disabled="@formDisabled">
                @if (isPermanent)
                {
                    <text>Permanently Locked</text>
                }
                else if (isTimedLock)
                {
                    <text>Account Locked</text>
                }
                else
                {
                    <text>Log in</text>
                }
            </button>
        </form>
    </div>
</div>

<div class="page-footer">
    © 2026 RJED Fleet Expense
</div>

@if (isTimedLock && Model.LockoutRemainingSeconds > 0)
{
    <script>
        (function () {
            var end = Date.now() + @Model.LockoutRemainingSeconds * 1000;
            var timerEl = document.getElementById('lockTimer');
            var btnEl = document.getElementById('loginBtn');
            function pad(n) {
                return n < 10 ? '0' + n : '' + n;
            }
            function tick() {
                var rem = Math.max(0,
                    Math.ceil((end - Date.now()) / 1000));
                var m = Math.floor(rem / 60);
                var s = rem % 60;
                timerEl.textContent = m + ':' + pad(s);
                if (rem <= 0) {
                    timerEl.textContent = '0:00';
                    document
                        .querySelectorAll('input')
                        .forEach(function (el) {
                            el.disabled = false;
                        });
                    if (btnEl) {
                        btnEl.disabled = false;
                        btnEl.textContent = 'Log in';
                    }
                    setTimeout(function () {
                        location.reload();
                    }, 600);
                    return;
                }
                setTimeout(tick, 500);
            }
            tick();
        })();
    </script>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}