@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<style>
    .custom-navbar {
        background: linear-gradient(90deg, #1e3c72, #2a5298);
        padding: 12px 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .custom-navbar .nav-link {
            color: #fff !important;
            font-weight: 500;
        }

    .welcome-text {
        color: #ffd369 !important;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .btn-custom-login {
        background-color: #ffffff;
        color: #2a5298;
        font-weight: 500;
        border-radius: 20px;
        padding: 5px 15px;
        transition: 0.3s ease;
    }

        .btn-custom-login:hover {
            background-color: #f1f1f1;
            transform: translateY(-2px);
        }

    .btn-custom-register {
        border-radius: 20px;
        padding: 5px 15px;
        font-weight: 500;
        transition: 0.3s ease;
    }

        .btn-custom-register:hover {
            transform: translateY(-2px);
        }

    .btn-logout {
        border-radius: 20px;
        padding: 5px 15px;
        transition: 0.3s ease;
    }

        .btn-logout:hover {
            background-color: #dc3545;
            color: white;
        }
</style>

<nav class="navbar navbar-expand-lg custom-navbar">
    <div class="container-fluid justify-content-center">
        <ul class="navbar-nav align-items-center">

            @if (SignInManager.IsSignedIn(User))
            {
                <li class="nav-item me-3">
                    <span class="nav-link welcome-text">
                        👋 Hello, @User.Identity?.Name!
                    </span>
                </li>

                <li class="nav-item">
                    <form class="d-inline"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

                        <button type="submit" class="btn btn-outline-light btn-sm btn-logout">
                            Logout
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li class="nav-item me-2">
                    <a class="btn btn-outline-light btn-sm btn-custom-register"
                       asp-area="Identity"
                       asp-page="/Account/Register">
                        Register
                    </a>
                </li>

                <li class="nav-item">
                    <a class="btn btn-custom-login btn-sm"
                       asp-area="Identity"
                       asp-page="/Account/Login">
                        Login
                    </a>
                </li>
            }

        </ul>
    </div>
</nav>
