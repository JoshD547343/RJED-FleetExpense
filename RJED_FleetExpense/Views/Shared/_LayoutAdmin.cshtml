@{
    var hideSidebar = ViewData["HideSidebar"] as bool? ?? false;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var userName = User.FindFirst("FullName")?.Value
                ?? User.Identity?.Name ?? "Administrator";
    var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "A";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RJED Fleet Expense</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Familjen+Grotesk:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            /* ===== THEME: ADMIN - blue and green ===== */
            --ink: #0a2540;
            --ink-2: #123a66;
            --ink-3: #1a4f8a;
            --sb-bg: #0a2540;
            --sb-hover: #123a66;
            --accent: #10b981;
            --accent-bg: rgba(16,185,129,0.16);
            --accent-border: rgba(16,185,129,0.40);
            --pill-text: #6ee7b7;
            --slate: #f4f6fb;
            --border: #e4e9f3;
            --card: #ffffff;
            --text: #1a2035;
            --muted: #7b8aaa;
            --sb-border: rgba(255,255,255,0.08);
            --sb-text: rgba(255,255,255,0.68);
            --sb-hi: #ffffff;
            --sidebar-w: 236px;
            --topbar-h: 62px;
            --radius: 10px;
            --radius-sm: 6px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background: var(--slate);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text);
            font-size: 14px;
            line-height: 1.6;
        }

        /* ---------- Sidebar ---------- */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--sb-bg);
            display: flex;
            flex-direction: column;
            z-index: 1040;
            overflow-y: auto;
            scrollbar-width: none;
        }

            .sidebar::-webkit-scrollbar {
                display: none;
            }

        .sb-brand {
            padding: 1.35rem 1.2rem 1.1rem;
            border-bottom: 1px solid var(--sb-border);
        }

        .sb-brand-name {
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 1rem;
            color: #fff;
            letter-spacing: -0.3px;
        }

        .sb-brand-sub {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.40);
            margin-top: 2px;
        }

        .sb-role-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: var(--accent-bg);
            border: 1px solid var(--accent-border);
            color: var(--pill-text);
            border-radius: 20px;
            padding: 2px 9px;
            font-size: 0.64rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-top: 9px;
        }

        .sb-user {
            padding: 0.75rem 1.2rem;
            border-bottom: 1px solid var(--sb-border);
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .sb-avatar {
            width: 33px;
            height: 33px;
            border-radius: 8px;
            background: var(--ink-3);
            border: 2px solid var(--accent);
            color: #fff;
            font-size: 0.76rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .sb-user-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 150px;
        }

        .sb-user-sub {
            font-size: 0.65rem;
            color: rgba(255,255,255,0.45);
        }

        .sb-nav {
            flex: 1;
            padding: 0.4rem 0.55rem;
        }

        .sb-section {
            font-size: 0.61rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.32);
            padding: 0.95rem 10px 0.3rem;
        }

        .sb-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            color: var(--sb-text);
            font-size: 0.845rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.15s;
            margin-bottom: 1px;
            position: relative;
        }

            .sb-link i {
                font-size: 0.95rem;
                width: 17px;
                text-align: center;
            }

            .sb-link:hover {
                background: var(--sb-hover);
                color: var(--sb-hi);
                transform: translateX(2px);
            }

            .sb-link.active {
                background: var(--sb-hover);
                color: #fff;
                font-weight: 600;
            }

                .sb-link.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 18%;
                    bottom: 18%;
                    width: 3px;
                    border-radius: 2px;
                    background: var(--accent);
                }

        .sb-bottom {
            padding: 0.55rem;
            border-top: 1px solid var(--sb-border);
        }

        .sb-divider {
            border-color: var(--sb-border);
            margin: 4px 0;
        }

        .sb-logout {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            background: none;
            border: none;
            color: rgba(255,255,255,0.60);
            font-size: 0.845rem;
            cursor: pointer;
        }

            .sb-logout:hover {
                background: #c0392b;
                color: #fff;
            }

        /* ---------- Main area ---------- */
        .main-wrap {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            height: var(--topbar-h);
            background: var(--card);
            border-bottom: 1px solid var(--border);
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .topbar-title {
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--ink);
        }

        .topbar-sub {
            font-size: 0.72rem;
            color: var(--muted);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .tb-avatar {
            width: 33px;
            height: 33px;
            border-radius: 8px;
            background: var(--ink-3);
            border: 2px solid var(--accent);
            color: #fff;
            font-size: 0.76rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sb-toggle {
            display: none;
            width: 35px;
            height: 35px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--card);
            color: var(--muted);
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.1rem;
            margin-right: 0.5rem;
        }

        .flash-bar {
            padding: 0.65rem 2rem;
            font-size: 0.845rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .flash-success {
            background: #d1fae5;
            color: #065f46;
            border-bottom: 1px solid #6ee7b7;
        }

        .flash-warning {
            background: #fef3c7;
            color: #92400e;
            border-bottom: 1px solid #fcd34d;
        }

        .flash-error {
            background: #fee2e2;
            color: #991b1b;
            border-bottom: 1px solid #fca5a5;
        }

        .page-body {
            padding: 1.8rem 2rem;
            flex: 1;
        }

        .sb-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 1039;
        }

            .sb-overlay.show {
                display: block;
            }

        @@media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.24s ease;
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-wrap {
                margin-left: 0;
            }

            .sb-toggle {
                display: flex;
            }

            .page-body {
                padding: 1.2rem;
            }

            .topbar {
                padding: 0 1.2rem;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    @if (hideSidebar)
    {
        <div class="container-fluid p-0">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

        <nav class="sidebar" id="sidebar">
            <div class="sb-brand">
                <div class="sb-brand-name">RJED Fleet Expense</div>
                <div class="sb-brand-sub">Management System</div>
                <span class="sb-role-pill">
                    <i class="bi bi-shield-lock"></i> Administrator
                </span>
            </div>

            <div class="sb-user">
                <div class="sb-avatar">@userInitial</div>
                <div>
                    <div class="sb-user-name">@userName</div>
                    <div class="sb-user-sub">System Administrator</div>
                </div>
            </div>

            <div class="sb-nav">
                <div class="sb-section">Overview</div>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "Dashboard" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="Dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <div class="sb-section">Management</div>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "ManageUser" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="ManageUser">
                    <i class="bi bi-people"></i> Manage Users
                </a>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "Department" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="Department">
                    <i class="bi bi-building"></i> Departments
                </a>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "Vehicles" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="Vehicles">
                    <i class="bi bi-truck"></i> Vehicles
                </a>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "Expense" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="Expense">
                    <i class="bi bi-receipt"></i> Expenses
                </a>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "Budgets" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="Budgets">
                    <i class="bi bi-wallet2"></i> Budget &amp; Cost Control
                </a>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "AuditLogs" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="AuditLogs">
                    <i class="bi bi-journal-text"></i> Audit Logs
                </a>
                <a class="sb-link @(currentController == "AdminDashboard" && currentAction == "Reports" ? "active" : "")"
                   asp-controller="AdminDashboard" asp-action="Reports">
                    <i class="bi bi-bar-chart-line"></i> Reports
                </a>
            </div>

            <div class="sb-bottom">
                <hr class="sb-divider" />
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sb-logout">
                        <i class="bi bi-box-arrow-left"></i> Logout
                    </button>
                </form>
            </div>
        </nav>

        <div class="main-wrap">
            <header class="topbar">
                <div style="display:flex;align-items:center">
                    <button class="sb-toggle" onclick="openSidebar()" aria-label="Open menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <div class="topbar-title">Welcome back, @userName 👋</div>
                        <div class="topbar-sub">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</div>
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="tb-avatar">@userInitial</div>
                </div>
            </header>

            @if (TempData["Success"] != null)
            {
                <div class="flash-bar flash-success">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="flash-bar flash-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Warning"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="flash-bar flash-error">
                    <i class="bi bi-x-circle-fill"></i> @TempData["Error"]
                </div>
            }

            <main class="page-body">
                <div class="container-fluid px-0">
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sbOverlay').classList.add('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sbOverlay').classList.remove('show');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>