@model RJED_FleetExpense.ViewModels.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutEmployee.cshtml";

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    var totalStatus = Model.MyPendingExpenses + Model.RecentlyApproved + Model.RejectedThisMonth;
    double Pct(int v) => totalStatus == 0 ? 0 : Math.Round(v * 100.0 / totalStatus, 1);
    var pendingPct = Pct(Model.MyPendingExpenses);
    var approvedPct = Pct(Model.RecentlyApproved);
    var rejectedPct = Pct(Model.RejectedThisMonth);
}

@section Styles {
    <style>
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: #fff;
            border: 1px solid var(--border);
            border-left: 4px solid transparent;
            border-radius: 12px;
            padding: 1.05rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .stat-card:nth-child(1) {
                border-left-color: #f59e0b;
                animation-delay: 0s;
            }

            .stat-card:nth-child(2) {
                border-left-color: #10b981;
                animation-delay: 0.06s;
            }

            .stat-card:nth-child(3) {
                border-left-color: #3b82f6;
                animation-delay: 0.12s;
            }

            .stat-card:nth-child(4) {
                border-left-color: #ef4444;
                animation-delay: 0.18s;
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .stat-label {
            font-size: 0.68rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .7px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--muted);
        }

        .stat-value {
            margin-left: auto;
            text-align: right;
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.1;
        }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.85rem;
            margin-bottom: 1.4rem;
        }

        .quick-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem 1.15rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            color: var(--text);
            transition: border-color 0.16s, box-shadow 0.16s, transform 0.16s;
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .quick-card:nth-child(1) {
                animation-delay: 0.2s;
            }

            .quick-card:nth-child(2) {
                animation-delay: 0.25s;
            }

            .quick-card:nth-child(3) {
                animation-delay: 0.3s;
            }

            .quick-card:hover {
                border-color: var(--ink);
                box-shadow: 0 4px 14px rgba(15,22,35,0.07);
                transform: translateY(-2px);
                color: var(--ink);
            }

        .quick-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .quick-title {
            font-weight: 700;
            font-size: 0.875rem;
            color: var(--ink);
        }

        .quick-sub {
            font-size: 0.73rem;
            color: var(--muted);
            margin-top: 1px;
        }

        .quick-arrow {
            margin-left: auto;
            color: var(--muted);
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        .sc {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
        }

        .sc-head {
            padding: 0.85rem 1.2rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sc-title {
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sc-viewall {
            font-size: .78rem;
            font-weight: 600;
            color: #10b981;
            text-decoration: none;
        }

        .sc-body {
            padding: 1.1rem 1.2rem;
        }

        .ex-table {
            width: 100%;
            border-collapse: collapse;
        }

            .ex-table thead th {
                background: #f8faff;
                color: var(--muted);
                font-size: 0.66rem;
                text-transform: uppercase;
                letter-spacing: .6px;
                padding: 0.7rem 1rem;
                text-align: left;
                white-space: nowrap;
            }

            .ex-table tbody td {
                padding: 0.78rem 1rem;
                border-bottom: 1px solid var(--border);
                font-size: .84rem;
                vertical-align: middle;
            }

            .ex-table tbody tr:last-child td {
                border-bottom: none;
            }

            .ex-table tbody tr:hover {
                background: #f8faff;
            }

        .expense-id {
            color: var(--muted);
            font-size: .78rem;
            font-family: "Consolas", monospace;
            white-space: nowrap;
        }

        .amt {
            font-family: 'Familjen Grotesk', sans-serif;
            font-weight: 700;
            color: var(--ink);
            white-space: nowrap;
        }

        .st {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .st-ok {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .st-acc {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .st-pend {
            background: #fffbeb;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        .st-rej {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .bar-wrap {
            margin-bottom: 1rem;
        }

            .bar-wrap:last-child {
                margin-bottom: 0;
            }

        .bar-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.78rem;
            font-weight: 600;
            margin-bottom: 4px;
            color: var(--text);
        }

        .bar-track {
            height: 7px;
            background: var(--border);
            border-radius: 10px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.8s ease;
        }

        .empty-box {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--muted);
        }

            .empty-box i {
                font-size: 2rem;
                opacity: .25;
                display: block;
                margin-bottom: .5rem;
            }

        .welcome {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .5rem;
            margin-bottom: 1.2rem;
            font-size: .82rem;
            color: var(--muted);
        }

        .id-chip {
            background: var(--ink);
            color: #fff;
            font-size: .72rem;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 20px;
        }

        @@keyframes rise {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 1200px) {
            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .quick-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 575px) {
            .stat-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="welcome">
    <span>Welcome back, <strong style="color:var(--ink)">@Model.CurrentUserName</strong> &middot; @DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
    <span class="id-chip"><i class="bi bi-person-badge-fill me-1"></i> @Model.EmployeeId</span>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:#fffbeb;color:#f59e0b"><i class="bi bi-hourglass-split"></i></div>
        <div>
            <div class="stat-label">Pending Approval</div>
            <div class="stat-sub">Needs your action</div>
        </div>
        <div class="stat-value">@Model.MyPendingExpenses</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#ecfdf5;color:#10b981"><i class="bi bi-calendar-check"></i></div>
        <div>
            <div class="stat-label">This Month</div>
            <div class="stat-sub">&#8369;@Model.MyTotalThisMonthAmount.ToString("N2")</div>
        </div>
        <div class="stat-value">@Model.MyTotalThisMonth</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#eff6ff;color:#3b82f6"><i class="bi bi-check-circle"></i></div>
        <div>
            <div class="stat-label">Total Approved</div>
            <div class="stat-sub">All time</div>
        </div>
        <div class="stat-value">@Model.RecentlyApproved</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#fef2f2;color:#ef4444"><i class="bi bi-x-circle"></i></div>
        <div>
            <div class="stat-label">Rejected</div>
            <div class="stat-sub">@DateTime.Now.ToString("MMMM yyyy")</div>
        </div>
        <div class="stat-value">@Model.RejectedThisMonth</div>
    </div>
</div>

<!-- Quick links -->
<div class="quick-grid">
    <a asp-controller="EmployeeDashboard" asp-action="MyExpenses" class="quick-card">
        <div class="quick-icon" style="background:#ecfdf5;color:#10b981"><i class="bi bi-receipt"></i></div>
        <div>
            <div class="quick-title">My Expenses</div>
            <div class="quick-sub">Submit and track claims</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>
    <a asp-controller="Employee" asp-action="Reimbursement_Status" class="quick-card">
        <div class="quick-icon" style="background:#eff6ff;color:#3b82f6"><i class="bi bi-arrow-repeat"></i></div>
        <div>
            <div class="quick-title">Reimbursement Status</div>
            <div class="quick-sub">Follow your payouts</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>
    <a asp-controller="EmployeeDashboard" asp-action="Profile" class="quick-card">
        <div class="quick-icon" style="background:#fefce8;color:#ca8a04"><i class="bi bi-person-circle"></i></div>
        <div>
            <div class="quick-title">My Profile</div>
            <div class="quick-sub">Update your details</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>
</div>

<!-- Bottom Row -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="sc">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-clock-history"></i> My Recent Expenses</h6>
                <a asp-controller="EmployeeDashboard" asp-action="MyExpenses" class="sc-viewall">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (Model.MyExpenses != null && Model.MyExpenses.Any())
            {
                <div style="overflow-x:auto">
                    <table class="ex-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Date</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in Model.MyExpenses.Take(8))
                            {
                                <tr>
                                    <td class="expense-id">EXP-@exp.Id.ToString("D4")</td>
                                    <td style="white-space:nowrap;color:var(--muted);font-size:0.8rem">@exp.ExpenseDate.ToString("MMM dd, yyyy")</td>
                                    <td>@exp.ExpenseType</td>
                                    <td class="amt">&#8369;@exp.Amount.ToString("N2")</td>
                                    <td>
                                        @if (exp.Status == "Reimbursed")
                                        {
                                            <span class="st st-ok"><i class="bi bi-check-circle-fill"></i> Reimbursed</span>
                                        }
                                        else if (exp.Status == "Rejected")
                                        {
                                            <span class="st st-rej"><i class="bi bi-x-circle-fill"></i> Rejected</span>
                                        }
                                        else if (exp.Status == "Approved" || exp.Status == "DepartmentApproved" || exp.Status == "ForAccounting")
                                        {
                                            <span class="st st-acc"><i class="bi bi-send-check-fill"></i> Approved</span>
                                        }
                                        else
                                        {
                                            <span class="st st-pend"><i class="bi bi-hourglass-split"></i> Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-inbox"></i>
                    <p class="mb-0">You haven't submitted any expenses yet.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sc">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-pie-chart"></i> Expense Status</h6>
            </div>
            <div class="sc-body">
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#10b981;font-size:0.6rem;"></i>Approved</span>
                        <span>@Model.RecentlyApproved items</span>
                    </div>
                    <div class="bar-track"><div class="bar-fill" style="width:@approvedPct.ToString("0.#", inv)%;background:#10b981"></div></div>
                </div>
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#f59e0b;font-size:0.6rem;"></i>Pending</span>
                        <span>@Model.MyPendingExpenses items</span>
                    </div>
                    <div class="bar-track"><div class="bar-fill" style="width:@pendingPct.ToString("0.#", inv)%;background:#f59e0b"></div></div>
                </div>
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#ef4444;font-size:0.6rem;"></i>Rejected</span>
                        <span>@Model.RejectedThisMonth items</span>
                    </div>
                    <div class="bar-track"><div class="bar-fill" style="width:@rejectedPct.ToString("0.#", inv)%;background:#ef4444"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>