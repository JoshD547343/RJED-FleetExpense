@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section Styles {
    <style>
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-left: 4px solid transparent;
            border-radius: 12px;
            padding: 1.05rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .stat-card:nth-child(1) {
                border-left-color: #ca8a04;
                animation-delay: 0s;
            }

            .stat-card:nth-child(2) {
                border-left-color: var(--green);
                animation-delay: 0.06s;
            }

            .stat-card:nth-child(3) {
                border-left-color: #3b82f6;
                animation-delay: 0.12s;
            }

            .stat-card:nth-child(4) {
                border-left-color: var(--red);
                animation-delay: 0.18s;
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .stat-label {
            font-size: 0.68rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .7px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--muted);
        }

        .stat-value {
            margin-left: auto;
            text-align: right;
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.1;
        }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.85rem;
            margin-bottom: 1.4rem;
        }

        .quick-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem 1.15rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            color: var(--text);
            transition: border-color 0.16s, box-shadow 0.16s, transform 0.16s;
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .quick-card:nth-child(1) {
                animation-delay: 0.22s;
            }

            .quick-card:nth-child(2) {
                animation-delay: 0.27s;
            }

            .quick-card:nth-child(3) {
                animation-delay: 0.32s;
            }

            .quick-card:hover {
                border-color: var(--ink-2);
                box-shadow: 0 4px 14px rgba(15,22,35,0.07);
                transform: translateY(-2px);
                color: var(--ink);
            }

        .quick-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .quick-title {
            font-weight: 700;
            font-size: 0.875rem;
            color: var(--ink);
        }

        .quick-sub {
            font-size: 0.73rem;
            color: var(--muted);
            margin-top: 1px;
        }

        .quick-arrow {
            margin-left: auto;
            color: var(--muted);
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        .sc {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
        }

        .sc-head {
            padding: 0.85rem 1.2rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sc-title {
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sc-viewall {
            font-size: .78rem;
            font-weight: 600;
            color: var(--green);
            text-decoration: none;
        }

        .sc-body {
            padding: 1.1rem 1.2rem;
        }

        .ex-table {
            width: 100%;
            border-collapse: collapse;
        }

            .ex-table thead th {
                background: #f8faff;
                color: var(--muted);
                font-size: 0.66rem;
                text-transform: uppercase;
                letter-spacing: .6px;
                padding: 0.7rem 1rem;
                text-align: left;
            }

            .ex-table tbody td {
                padding: 0.78rem 1rem;
                border-bottom: 1px solid var(--border);
                font-size: .84rem;
                vertical-align: middle;
            }

            .ex-table tbody tr:last-child td {
                border-bottom: none;
            }

            .ex-table tbody tr:hover {
                background: #f8faff;
            }

        .amt {
            font-family: 'Familjen Grotesk', sans-serif;
            font-weight: 700;
            color: var(--ink);
        }

        .st {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .st-ok {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .st-pend {
            background: #fffbeb;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        .st-rej {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: var(--ink-3);
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .breakdown-bar {
            margin-bottom: 1rem;
        }

        .breakdown-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.78rem;
            font-weight: 600;
            margin-bottom: 4px;
            color: var(--text);
        }

        .breakdown-track {
            height: 7px;
            background: var(--border);
            border-radius: 10px;
            overflow: hidden;
        }

        .breakdown-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.8s ease;
        }

        .empty-box {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--muted);
            font-size: 0.845rem;
        }

            .empty-box i {
                font-size: 2rem;
                opacity: .25;
                display: block;
                margin-bottom: .5rem;
            }

        @@keyframes rise {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 1200px) {
            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 992px) {
            .quick-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .stat-grid,
            .quick-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:#fefce8;color:#ca8a04">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <div class="stat-label">Total Users</div>
            <div class="stat-sub">Registered</div>
        </div>
        <div class="stat-value">@(ViewBag.TotalUsers ?? 0)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#ecfdf5;color:var(--green)">
            <i class="bi bi-cash-stack"></i>
        </div>
        <div>
            <div class="stat-label">Expenses This Month</div>
            <div class="stat-sub">@DateTime.Now.ToString("MMMM yyyy")</div>
        </div>
        <div class="stat-value">&#8369;@String.Format("{0:N0}", ViewBag.TotalExpensesThisMonth ?? 0)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#f0f9ff;color:#3b82f6">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
            <div class="stat-label">Pending Approvals</div>
            <div class="stat-sub">Requires action</div>
        </div>
        <div class="stat-value">@(ViewBag.PendingApprovals ?? 0)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#fef2f2;color:var(--red)">
            <i class="bi bi-building"></i>
        </div>
        <div>
            <div class="stat-label">Active Departments</div>
            <div class="stat-sub">Distinct</div>
        </div>
        <div class="stat-value">@(ViewBag.ActiveDepartments ?? 0)</div>
    </div>
</div>

<!-- Quick Actions -->
<div class="quick-grid">
    <a asp-controller="AdminDashboard" asp-action="ManageUser" class="quick-card">
        <div class="quick-icon" style="background:#fefce8;color:#ca8a04">
            <i class="bi bi-person-plus"></i>
        </div>
        <div>
            <div class="quick-title">Manage Users</div>
            <div class="quick-sub">Add / edit / deactivate</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>

    <a asp-controller="AdminDashboard" asp-action="Expense" class="quick-card">
        <div class="quick-icon" style="background:#ecfdf5;color:var(--green)">
            <i class="bi bi-receipt"></i>
        </div>
        <div>
            <div class="quick-title">All Expenses</div>
            <div class="quick-sub">View all submissions</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>

    <a asp-controller="AdminDashboard" asp-action="Reports" class="quick-card">
        <div class="quick-icon" style="background:#fef2f2;color:var(--red)">
            <i class="bi bi-bar-chart-line"></i>
        </div>
        <div>
            <div class="quick-title">Reports</div>
            <div class="quick-sub">Analytics &amp; exports</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>
</div>

<!-- Main Content -->
<div class="row g-4">

    <!-- LEFT: Recent Expenses -->
    <div class="col-lg-8">
        @{
            var recentExpenses = ViewBag.RecentExpenses as IEnumerable<RJED_FleetExpense.Models.Expense>;
        }
        <div class="sc">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-clock-history"></i> Recent Expense Submissions</h6>
                <a asp-controller="AdminDashboard" asp-action="Expense" class="sc-viewall">
                    View All Expenses <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (recentExpenses != null && recentExpenses.Any())
            {
                <div style="overflow-x:auto">
                    <table class="ex-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in recentExpenses)
                            {
                                var name = exp.User?.FullName ?? exp.User?.Email ?? "—";
                                var initials = exp.User?.FullName != null
                                ? string.Concat(exp.User.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()))
                                : "?";
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="user-avatar-sm">@initials</div>
                                            <div>
                                                <div style="font-weight:600;">@name</div>
                                                <small class="text-muted">@(exp.User?.Department ?? "")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@exp.ExpenseType</td>
                                    <td class="amt">&#8369;@exp.Amount.ToString("N2")</td>
                                    <td style="white-space:nowrap;color:var(--muted);font-size:0.8rem">@exp.ExpenseDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (exp.Status == "Approved")
                                        {
                                            <span class="st st-ok"><i class="bi bi-check-circle-fill"></i> Approved</span>
                                        }
                                        else if (exp.Status == "Rejected")
                                        {
                                            <span class="st st-rej"><i class="bi bi-x-circle-fill"></i> Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="st st-pend"><i class="bi bi-hourglass-split"></i> @exp.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-inbox"></i>
                    <p class="mb-0">No expense submissions yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-lg-4">

        <!-- Expense Breakdown -->
        <div class="sc mb-4">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-pie-chart"></i> Expense Breakdown</h6>
            </div>
            @{
                var approved = (decimal)(ViewBag.TotalApproved ?? 0m);
                var pending = (decimal)(ViewBag.TotalPending ?? 0m);
                var rejected = (decimal)(ViewBag.TotalRejected ?? 0m);
                var total = approved + pending + rejected;

                double approvedPct = total > 0 ? (double)(approved / total * 100) : 0;
                double pendingPct = total > 0 ? (double)(pending / total * 100) : 0;
                double rejectedPct = total > 0 ? (double)(rejected / total * 100) : 0;
            }
            @if (total > 0)
            {
                <div class="sc-body">
                    <div class="breakdown-bar">
                        <div class="breakdown-label">
                            <span><i class="bi bi-circle-fill me-1" style="color:#10b981;font-size:0.6rem;"></i>Approved</span>
                            <span>&#8369;@approved.ToString("N0")</span>
                        </div>
                        <div class="breakdown-track">
                            <div class="breakdown-fill" style="width:@approvedPct.ToString("F1")%;background:#10b981;"></div>
                        </div>
                    </div>
                    <div class="breakdown-bar">
                        <div class="breakdown-label">
                            <span><i class="bi bi-circle-fill me-1" style="color:#f59e0b;font-size:0.6rem;"></i>Pending</span>
                            <span>&#8369;@pending.ToString("N0")</span>
                        </div>
                        <div class="breakdown-track">
                            <div class="breakdown-fill" style="width:@pendingPct.ToString("F1")%;background:#f59e0b;"></div>
                        </div>
                    </div>
                    <div class="breakdown-bar">
                        <div class="breakdown-label">
                            <span><i class="bi bi-circle-fill me-1" style="color:#ef4444;font-size:0.6rem;"></i>Rejected</span>
                            <span>&#8369;@rejected.ToString("N0")</span>
                        </div>
                        <div class="breakdown-track">
                            <div class="breakdown-fill" style="width:@rejectedPct.ToString("F1")%;background:#ef4444;"></div>
                        </div>
                    </div>
                    <hr style="border-color:var(--border);margin:1rem 0 0.5rem;" />
                    <div class="d-flex justify-content-between" style="font-size:0.78rem;color:var(--muted);">
                        <span>Total All Time</span>
                        <span style="font-weight:700;color:var(--text);">&#8369;@total.ToString("N0")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-bar-chart"></i>
                    <p class="mb-0">No expense data yet.</p>
                </div>
            }
        </div>

        <!-- Recent Users -->
        <div class="sc">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-people"></i> Recent Users</h6>
                <a asp-controller="AdminDashboard" asp-action="ManageUser" class="sc-viewall">
                    Manage <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            @{
                var recentUsers = ViewBag.RecentUsers as IEnumerable<RJED_FleetExpense.Data.ApplicationUser>;
            }
            @if (recentUsers != null && recentUsers.Any())
            {
                <div class="sc-body">
                    @foreach (var u in recentUsers)
                    {
                        var initials = u.FullName != null
                        ? string.Concat(u.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()))
                        : (u.Email?[0].ToString().ToUpper() ?? "?");

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="user-avatar-sm">@initials</div>
                            <div style="min-width:0;flex:1;">
                                <div style="font-weight:600;font-size:0.845rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    @(u.FullName ?? u.Email ?? "—")
                                </div>
                                <small class="text-muted">@(u.Department ?? "No Department")</small>
                            </div>
                            @if (u.IsActive)
                            {
                                <span class="st st-ok">Active</span>
                            }
                            else
                            {
                                <span class="st st-rej">Inactive</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-people"></i>
                    <p class="mb-0">No users found.</p>
                </div>
            }
        </div>
    </div>
</div>