@{
    ViewData["Title"] = "Accounting Dashboard";
    Layout = "~/Views/Shared/_LayoutAccounting.cshtml";
}

@section Styles {
    <style>
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-left: 4px solid transparent;
            border-radius: 12px;
            padding: 1.05rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .stat-card:nth-child(1) {
                border-left-color: #3b82f6;
                animation-delay: 0s;
            }

            .stat-card:nth-child(2) {
                border-left-color: var(--green);
                animation-delay: 0.06s;
            }

            .stat-card:nth-child(3) {
                border-left-color: #ef4444;
                animation-delay: 0.12s;
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .stat-label {
            font-size: 0.68rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .7px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--muted);
        }

        .stat-value {
            margin-left: auto;
            text-align: right;
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.1;
        }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.85rem;
            margin-bottom: 1.4rem;
        }

        .quick-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem 1.15rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            color: var(--text);
            transition: border-color 0.16s, box-shadow 0.16s, transform 0.16s;
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .quick-card:nth-child(1) {
                animation-delay: 0.2s;
            }

            .quick-card:nth-child(2) {
                animation-delay: 0.25s;
            }

            .quick-card:nth-child(3) {
                animation-delay: 0.3s;
            }

            .quick-card:hover {
                border-color: var(--ink-2);
                box-shadow: 0 4px 14px rgba(15,22,35,0.07);
                transform: translateY(-2px);
                color: var(--ink);
            }

        .quick-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .quick-title {
            font-weight: 700;
            font-size: 0.875rem;
            color: var(--ink);
        }

        .quick-sub {
            font-size: 0.73rem;
            color: var(--muted);
            margin-top: 1px;
        }

        .quick-arrow {
            margin-left: auto;
            color: var(--muted);
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        .sc {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
        }

        .sc-head {
            padding: 0.85rem 1.2rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sc-title {
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sc-viewall {
            font-size: .78rem;
            font-weight: 600;
            color: var(--green);
            text-decoration: none;
        }

        .sc-body {
            padding: 1.1rem 1.2rem;
        }

        .ex-table {
            width: 100%;
            border-collapse: collapse;
        }

            .ex-table thead th {
                background: #f8faff;
                color: var(--muted);
                font-size: 0.66rem;
                text-transform: uppercase;
                letter-spacing: .6px;
                padding: 0.7rem 1rem;
                text-align: left;
            }

            .ex-table tbody td {
                padding: 0.78rem 1rem;
                border-bottom: 1px solid var(--border);
                font-size: .84rem;
            }

            .ex-table tbody tr:last-child td {
                border-bottom: none;
            }

            .ex-table tbody tr:hover {
                background: #f8faff;
            }

        .amt {
            font-family: 'Familjen Grotesk', sans-serif;
            font-weight: 700;
            color: var(--ink);
        }

        .st {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .st-acc {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .bar-wrap {
            margin-bottom: 1rem;
        }

        .bar-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.78rem;
            font-weight: 600;
            margin-bottom: 4px;
            color: var(--text);
        }

        .bar-track {
            height: 7px;
            background: var(--border);
            border-radius: 10px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.8s ease;
        }

        .empty-box {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--muted);
        }

            .empty-box i {
                font-size: 2rem;
                opacity: .25;
                display: block;
                margin-bottom: .5rem;
            }

        @@keyframes rise {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 992px) {
            .stat-grid, .quick-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:#f0f9ff;color:#3b82f6">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
            <div class="stat-label">Awaiting Payment</div>
            <div class="stat-sub">Approved, unpaid</div>
        </div>
        <div class="stat-value">@(ViewBag.ForPayment ?? 0)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#ecfdf5;color:var(--green)">
            <i class="bi bi-cash-coin"></i>
        </div>
        <div>
            <div class="stat-label">Total Reimbursed</div>
            <div class="stat-sub">@DateTime.Now.ToString("MMMM yyyy")</div>
        </div>
        <div class="stat-value">&#8369;@String.Format("{0:N0}", ViewBag.TotalReimbursed ?? 0)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#fef2f2;color:#ef4444">
            <i class="bi bi-x-circle"></i>
        </div>
        <div>
            <div class="stat-label">Total Rejected</div>
            <div class="stat-sub">All time</div>
        </div>
        <div class="stat-value">@(ViewBag.TotalRejected ?? 0)</div>
    </div>
</div>

<!-- Quick Actions -->
<div class="quick-grid">
    <a asp-controller="Accounting" asp-action="ProcessReimbursement" class="quick-card">
        <div class="quick-icon" style="background:#ecfdf5;color:var(--green)">
            <i class="bi bi-cash-coin"></i>
        </div>
        <div>
            <div class="quick-title">Process Reimbursements</div>
            <div class="quick-sub">Pay approved expenses</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>

    <a asp-controller="Accounting" asp-action="GenerateExpenseReport" class="quick-card">
        <div class="quick-icon" style="background:#fefce8;color:#ca8a04">
            <i class="bi bi-file-earmark-bar-graph"></i>
        </div>
        <div>
            <div class="quick-title">Expense Report</div>
            <div class="quick-sub">Generate &amp; export</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>

    <a asp-controller="Accounting" asp-action="FinancialAuditLog" class="quick-card">
        <div class="quick-icon" style="background:#f0f9ff;color:#3b82f6">
            <i class="bi bi-journal-check"></i>
        </div>
        <div>
            <div class="quick-title">Audit Logs</div>
            <div class="quick-sub">View financial trail</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>
</div>

<!-- Bottom Row -->
<div class="row g-4">
    <!-- Awaiting payment -->
    <div class="col-lg-8">
        <div class="sc">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-hourglass-split"></i> Awaiting Payment</h6>
                <a asp-controller="Accounting" asp-action="ProcessReimbursement" class="sc-viewall">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            @if (ViewBag.PendingList != null && ((IEnumerable<dynamic>)ViewBag.PendingList).Any())
            {
                <div style="overflow-x:auto">
                    <table class="ex-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.PendingList)
                            {
                                <tr>
                                    <td style="font-weight:600">@item.EmployeeName</td>
                                    <td>@item.Category</td>
                                    <td class="amt">&#8369;@String.Format("{0:N2}", item.Amount)</td>
                                    <td style="white-space:nowrap;color:var(--muted);font-size:0.8rem">@((item.ExpenseDate as DateTime?)?.ToString("MMM dd, yyyy"))</td>
                                    <td><span class="st st-acc"><i class="bi bi-send-check-fill"></i> With Accounting</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-inbox"></i>
                    <p class="mb-0">Nothing is waiting for payment.</p>
                </div>
            }
        </div>
    </div>

    <!-- Status breakdown -->
    <div class="col-lg-4">
        <div class="sc">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-pie-chart"></i> Claim Status</h6>
                <small class="text-muted">Share of all claims</small>
            </div>
            <div class="sc-body">
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#10b981;font-size:0.6rem;"></i>Reimbursed</span>
                        <span>@(ViewBag.ReimbursedPct ?? 0)%</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@(ViewBag.ReimbursedPct ?? 0)%;background:#10b981"></div>
                    </div>
                </div>
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#f59e0b;font-size:0.6rem;"></i>Awaiting payment</span>
                        <span>@(ViewBag.PendingPct ?? 0)%</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@(ViewBag.PendingPct ?? 0)%;background:#f59e0b"></div>
                    </div>
                </div>
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#ef4444;font-size:0.6rem;"></i>Rejected</span>
                        <span>@(ViewBag.RejectedPct ?? 0)%</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@(ViewBag.RejectedPct ?? 0)%;background:#ef4444"></div>
                    </div>
                </div>
                <hr style="border-color:var(--border);margin:1rem 0" />
                <canvas id="breakdownChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('breakdownChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Reimbursed', 'Awaiting payment', 'Rejected'],
                datasets: [{
                    data: [
                        @(ViewBag.ReimbursedPct ?? 0),
                        @(ViewBag.PendingPct ?? 0),
                        @(ViewBag.RejectedPct ?? 0)
                    ],
                    backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { size: 12 }, padding: 16, usePointStyle: true, pointStyleWidth: 10 }
                    },
                    tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.parsed + '%' } }
                },
                animation: { animateRotate: true, duration: 900 }
            }
        });
    </script>
}