@{
    ViewData["Title"] = "Budget Monitoring";
    Layout = "~/Views/Shared/_LayoutDepartment.cshtml";

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    decimal thisMonth = (decimal)(ViewBag.ThisMonthApproved ?? 0m);
    decimal lastMonth = (decimal)(ViewBag.LastMonthApproved ?? 0m);
    decimal totalApproved = (decimal)(ViewBag.TotalApproved ?? 0m);
    decimal totalPending = (decimal)(ViewBag.TotalPending ?? 0m);
    decimal totalRejected = (decimal)(ViewBag.TotalRejected ?? 0m);
    decimal grandTotal = totalApproved + totalPending + totalRejected;
    decimal safeGrand = grandTotal == 0 ? 1 : grandTotal;

    decimal mom = lastMonth > 0 ? ((thisMonth - lastMonth) / lastMonth * 100) : 0;
    bool momUp = mom >= 0;

    var byType = ViewBag.ByType as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var monthlyTotals = ViewBag.MonthlyTotals as decimal[] ?? new decimal[12];
    var monthNames = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    var palette = new[] { "#10b981", "#3b82f6", "#f59e0b", "#ef4444", "#8b5cf6", "#06b6d4", "#f97316", "#ec4899" };
}

@section Styles {
    <style>
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-left: 4px solid transparent;
            border-radius: 12px;
            padding: 1.05rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .stat-card:nth-child(1) {
                border-left-color: var(--green);
                animation-delay: 0s;
            }

            .stat-card:nth-child(2) {
                border-left-color: #3b82f6;
                animation-delay: 0.06s;
            }

            .stat-card:nth-child(3) {
                border-left-color: #f59e0b;
                animation-delay: 0.12s;
            }

            .stat-card:nth-child(4) {
                border-left-color: var(--red);
                animation-delay: 0.18s;
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .stat-label {
            font-size: 0.68rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .7px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--muted);
        }

        .stat-value {
            margin-left: auto;
            text-align: right;
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.1;
        }

        .mom-up {
            color: var(--green);
        }

        .mom-dn {
            color: var(--red);
        }

        .sc {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
            margin-bottom: 1.4rem;
        }

        .sc-head {
            padding: 0.85rem 1.2rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .5rem;
        }

        .sc-title {
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sc-body {
            padding: 1.1rem 1.2rem;
        }

        .bar-wrap {
            margin-bottom: 1rem;
        }

            .bar-wrap:last-child {
                margin-bottom: 0;
            }

        .bar-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.78rem;
            font-weight: 600;
            margin-bottom: 4px;
            color: var(--text);
        }

        .bar-track {
            height: 7px;
            background: var(--border);
            border-radius: 10px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.8s ease;
        }

        /* Type list */
        .type-row {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem 0;
            border-bottom: 1px solid var(--border);
        }

            .type-row:last-child {
                border-bottom: none;
            }

        .type-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .type-name {
            flex: 1;
            font-size: .84rem;
            font-weight: 600;
            color: var(--text);
        }

        .type-cnt {
            font-size: .73rem;
            color: var(--muted);
        }

        .type-amt {
            font-family: 'Familjen Grotesk', sans-serif;
            font-weight: 700;
            font-size: .92rem;
            color: var(--ink);
        }

        .type-pct {
            font-size: .73rem;
            color: var(--muted);
            min-width: 34px;
            text-align: right;
        }

        .empty-box {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--muted);
            font-size: .85rem;
        }

            .empty-box i {
                font-size: 2rem;
                opacity: .25;
                display: block;
                margin-bottom: .5rem;
            }

        @@keyframes rise {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 1200px) {
            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575px) {
            .stat-grid {
                grid-template-columns: 1fr;
            }

            .type-row {
                flex-wrap: wrap;
            }
        }
    </style>
}

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(16,185,129,0.10);color:var(--green)">
            <i class="bi bi-calendar-month"></i>
        </div>
        <div>
            <div class="stat-label">This Month</div>
            <div class="stat-sub @(momUp ? "mom-up" : "mom-dn")">
                <i class="bi bi-arrow-@(momUp ? "up" : "down")-short"></i>@(Math.Abs(mom).ToString("N1"))% vs last month
            </div>
        </div>
        <div class="stat-value">&#8369;@String.Format("{0:N0}", thisMonth)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#eff6ff;color:#3b82f6">
            <i class="bi bi-check2-all"></i>
        </div>
        <div>
            <div class="stat-label">Total Approved</div>
            <div class="stat-sub">All time</div>
        </div>
        <div class="stat-value">&#8369;@String.Format("{0:N0}", totalApproved)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#fff7ed;color:#f59e0b">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
            <div class="stat-label">Total Pending</div>
            <div class="stat-sub">Awaiting action</div>
        </div>
        <div class="stat-value">&#8369;@String.Format("{0:N0}", totalPending)</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#fef2f2;color:var(--red)">
            <i class="bi bi-x-circle"></i>
        </div>
        <div>
            <div class="stat-label">Total Rejected</div>
            <div class="stat-sub">All time</div>
        </div>
        <div class="stat-value">&#8369;@String.Format("{0:N0}", totalRejected)</div>
    </div>
</div>

<!-- Charts row -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="sc" style="height:calc(100% - 1.4rem)">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-bar-chart-line"></i> Monthly Approved Spending &mdash; @DateTime.Now.Year</h6>
            </div>
            <div class="sc-body">
                <canvas id="monthlyChart" height="220"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sc">
            <div class="sc-head">
                <h6 class="sc-title"><i class="bi bi-pie-chart"></i> Status Split</h6>
            </div>
            <div class="sc-body">
                <canvas id="statusChart" height="180"></canvas>
                <hr style="border-color:var(--border);margin:.9rem 0" />

                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#10b981;font-size:0.6rem;"></i>Approved</span>
                        <span>@((totalApproved / safeGrand * 100).ToString("N0"))%</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@((totalApproved / safeGrand * 100).ToString("F1", inv))%;background:#10b981"></div>
                    </div>
                </div>
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#f59e0b;font-size:0.6rem;"></i>Pending</span>
                        <span>@((totalPending / safeGrand * 100).ToString("N0"))%</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@((totalPending / safeGrand * 100).ToString("F1", inv))%;background:#f59e0b"></div>
                    </div>
                </div>
                <div class="bar-wrap">
                    <div class="bar-label">
                        <span><i class="bi bi-circle-fill me-1" style="color:#ef4444;font-size:0.6rem;"></i>Rejected</span>
                        <span>@((totalRejected / safeGrand * 100).ToString("N0"))%</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@((totalRejected / safeGrand * 100).ToString("F1", inv))%;background:#ef4444"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Spending by type -->
<div class="sc">
    <div class="sc-head">
        <h6 class="sc-title"><i class="bi bi-tag"></i> Spending by Expense Type</h6>
        <small class="text-muted">Approved only</small>
    </div>
    @{
        decimal typeTotal = byType.Any() ? (decimal)byType.Sum(t => (decimal)t.Total) : 1m;
        int pi = 0;
    }
    @if (byType.Any())
    {
        <div class="sc-body">
            @foreach (var t in byType)
            {
                decimal pct = typeTotal > 0 ? ((decimal)t.Total / typeTotal * 100) : 0;
                string color = palette[pi % palette.Length];
                pi++;
                <div class="type-row">
                    <span class="type-dot" style="background:@color"></span>
                    <span class="type-name">@t.Type</span>
                    <span class="type-cnt">@t.Count txn(s)</span>
                    <span class="type-amt">&#8369;@String.Format("{0:N2}", (decimal)t.Total)</span>
                    <span class="type-pct">@pct.ToString("N0")%</span>
                    <div style="flex:1;max-width:140px;min-width:80px">
                        <div class="bar-track">
                            <div class="bar-fill" style="width:@pct.ToString("F1", inv)%;background:@color"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-box">
            <i class="bi bi-inbox"></i>
            No approved expense data yet.
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthNames));
            var data   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyTotals));

            var mCtx = document.getElementById('monthlyChart');
            if (mCtx) {
                new Chart(mCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Approved (₱)',
                            data: data,
                            backgroundColor: 'rgba(16,185,129,0.18)',
                            borderColor: '#10b981',
                            borderWidth: 2,
                            borderRadius: 6,
                            hoverBackgroundColor: 'rgba(16,185,129,0.35)'
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f1623',
                                titleColor: '#fff', bodyColor: '#94a3b8',
                                cornerRadius: 8, padding: 10,
                                callbacks: {
                                    label: ctx => '₱' + ctx.parsed.y.toLocaleString('en-PH', { minimumFractionDigits: 2 })
                                }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: '#7b8aaa', font: { family: 'Plus Jakarta Sans', size: 11 } } },
                            y: {
                                grid: { color: '#e4e9f3' },
                                ticks: { color: '#7b8aaa', font: { family: 'Plus Jakarta Sans', size: 11 }, callback: v => '₱' + v.toLocaleString() }
                            }
                        },
                        animation: { duration: 900, easing: 'easeInOutQuart' }
                    }
                });
            }

            var sCtx = document.getElementById('statusChart');
            if (sCtx) {
                new Chart(sCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Approved', 'Pending', 'Rejected'],
                        datasets: [{
                            data: [@totalApproved.ToString(inv), @totalPending.ToString(inv), @totalRejected.ToString(inv)],
                            backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                            borderWidth: 4, borderColor: '#fff', hoverOffset: 5
                        }]
                    },
                    options: {
                        cutout: '67%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    color: '#7b8aaa',
                                    font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' },
                                    padding: 14, usePointStyle: true, pointStyleWidth: 8
                                }
                            },
                            tooltip: { backgroundColor: '#0f1623', titleColor: '#fff', bodyColor: '#94a3b8', cornerRadius: 8, padding: 9 }
                        },
                        animation: { duration: 800, easing: 'easeInOutQuart' }
                    }
                });
            }
        })();
    </script>
}