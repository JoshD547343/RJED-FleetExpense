@* Views/Supervisor/PendingExpense.cshtml *@
@model RJED.ViewModels.Supervisor.PendingExpensesPageViewModel
@{
    ViewData["Title"] = "Pending Review";
    Layout = "~/Views/Shared/_LayoutSupervisor.cshtml";

    var totalAmount = Model.Expenses.Sum(e => e.Amount);
    var oldestDate = Model.Expenses.Any()
        ? Model.Expenses.Min(e => e.DateSubmitted)
        : (DateTime?)null;
}

@section Styles {
    <style>
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-left: 4px solid transparent;
            border-radius: 12px;
            padding: 1.05rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.38s ease forwards;
        }

            .stat-card:nth-child(1) {
                border-left-color: var(--amber);
                animation-delay: 0s;
            }

            .stat-card:nth-child(2) {
                border-left-color: var(--green);
                animation-delay: 0.06s;
            }

            .stat-card:nth-child(3) {
                border-left-color: var(--blue);
                animation-delay: 0.12s;
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .stat-label {
            font-size: 0.68rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .7px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--muted);
        }

        .stat-value {
            margin-left: auto;
            text-align: right;
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.1;
        }

        .urgent-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .75rem;
            background: #fffbeb;
            border: 1.5px solid #fcd34d;
            border-radius: 10px;
            padding: .75rem 1.1rem;
            margin-bottom: 1.2rem;
        }

        .urgent-bar-left {
            display: flex;
            align-items: center;
            gap: .55rem;
        }

        .urgent-bar-text {
            font-size: .855rem;
            color: #78350f;
            font-weight: 500;
        }

            .urgent-bar-text strong {
                font-weight: 700;
            }

        .sc {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(15,22,35,0.04);
            margin-bottom: 1.4rem;
        }

        .sc-head {
            padding: 0.85rem 1.2rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .6rem;
        }

        .sc-title {
            font-family: 'Familjen Grotesk', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sc-body {
            padding: 1rem 1.2rem;
        }

        .sc-foot {
            padding: .75rem 1.2rem;
            border-top: 1px solid var(--border);
            background: #f8faff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .5rem;
            font-size: .78rem;
            color: var(--muted);
        }

        /* Filters */
        .fc-label {
            font-size: .68rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-bottom: 4px;
            display: block;
        }

        .fc-input {
            width: 100%;
            padding: 7px 11px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-family: inherit;
            font-size: .84rem;
            color: var(--text);
            background: #fff;
            outline: none;
        }

            .fc-input:focus {
                border-color: var(--ink-2);
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap i {
                position: absolute;
                left: .7rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted);
                font-size: .85rem;
                pointer-events: none;
            }

            .input-wrap .fc-input {
                padding-left: 2rem;
            }

        .btn-f {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            font-family: inherit;
            text-decoration: none;
        }

            .btn-f:hover {
                opacity: .9;
            }

        .btn-main {
            background: var(--ink);
            color: #fff;
        }

            .btn-main:hover {
                color: #fff;
            }

        .btn-green {
            background: var(--green);
            color: #fff;
        }

        .btn-red {
            background: var(--red);
            color: #fff;
        }

        .btn-clear {
            background: var(--slate);
            color: var(--muted);
            border: 1.5px solid var(--border);
        }

            .btn-clear:hover {
                color: var(--ink);
                border-color: var(--ink-2);
            }

        /* Table */
        .ex-table {
            width: 100%;
            border-collapse: collapse;
        }

            .ex-table thead th {
                background: #f8faff;
                color: var(--muted);
                font-size: 0.66rem;
                text-transform: uppercase;
                letter-spacing: .6px;
                padding: 0.7rem 1rem;
                text-align: left;
                white-space: nowrap;
            }

            .ex-table tbody td {
                padding: 0.78rem 1rem;
                border-bottom: 1px solid var(--border);
                font-size: .84rem;
                vertical-align: middle;
            }

            .ex-table tbody tr:last-child td {
                border-bottom: none;
            }

            .ex-table tbody tr:hover {
                background: #f8faff;
            }

        .emp-cell {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: var(--ink-3);
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .emp-name {
            font-weight: 600;
            color: var(--ink);
        }

        .emp-dept {
            font-size: .72rem;
            color: var(--muted);
        }

        .type-badge {
            display: inline-block;
            padding: 2px 9px;
            background: #f1f5f9;
            border-radius: 6px;
            font-size: .76rem;
            font-weight: 600;
            color: var(--ink);
        }

        .plate-chip {
            font-family: 'Consolas', monospace;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: .78rem;
            color: var(--ink);
            background: #f1f5f9;
            border-radius: 6px;
            padding: 2px 8px;
        }

        .amt {
            font-family: 'Familjen Grotesk', sans-serif;
            font-weight: 700;
            color: var(--ink);
            white-space: nowrap;
        }

        td.muted-sm {
            color: var(--muted);
            font-size: .8rem;
            white-space: nowrap;
        }

        .desc-cell {
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: block;
        }

        .st {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .st-pend {
            background: #fffbeb;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        .act-group {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .act {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1.5px solid transparent;
            font-size: .76rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            background: none;
            font-family: inherit;
            white-space: nowrap;
        }

        .act-approve {
            background: #ecfdf5;
            color: var(--green);
            border-color: #a7f3d0;
        }

            .act-approve:hover {
                background: var(--green);
                color: #fff;
                border-color: var(--green);
            }

        .act-reject {
            background: #fef2f2;
            color: var(--red);
            border-color: #fecaca;
        }

            .act-reject:hover {
                background: var(--red);
                color: #fff;
                border-color: var(--red);
            }

        .act-view {
            background: var(--slate);
            color: var(--muted);
            border-color: var(--border);
        }

            .act-view:hover {
                color: var(--ink);
                border-color: var(--ink-2);
            }

        .empty-box {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--muted);
        }

            .empty-box i {
                font-size: 2rem;
                opacity: .25;
                display: block;
                margin-bottom: .5rem;
            }

            .empty-box h6 {
                font-weight: 700;
                color: var(--ink);
                margin-bottom: .3rem;
            }

        /* Modals */
        .pm-modal {
            border: none;
            border-radius: 12px;
            overflow: hidden;
        }

            .pm-modal .modal-header {
                background: var(--ink);
                border-bottom: none;
                padding: 1rem 1.3rem;
            }

            .pm-modal .modal-title {
                color: #fff;
                font-size: .95rem;
                font-weight: 700;
            }

            .pm-modal .modal-body {
                padding: 1.3rem;
            }

            .pm-modal .modal-footer {
                border-top: 1px solid var(--border);
                padding: .85rem 1.3rem;
            }

        @@keyframes rise {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 992px) {
            .stat-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@if (Model.PendingCount > 0)
{
    <div class="urgent-bar">
        <div class="urgent-bar-left">
            <i class="bi bi-exclamation-triangle-fill" style="color:var(--amber);font-size:1.1rem"></i>
            <span class="urgent-bar-text">
                <strong>@Model.PendingCount expense(s)</strong> are waiting for your review.
            </span>
        </div>
        <span style="font-size:.78rem;color:#92400e;font-weight:600">
            <i class="bi bi-clock me-1"></i>
            @(oldestDate.HasValue ? $"Oldest: {oldestDate.Value:MMM d, yyyy}" : "Review now")
        </span>
    </div>
}

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:#fff7ed;color:var(--amber)">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
            <div class="stat-label">Awaiting Review</div>
            <div class="stat-sub">@(Model.PendingCount > 0 ? "Needs your action" : "All clear ✓")</div>
        </div>
        <div class="stat-value">@Model.PendingCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#ecfdf5;color:var(--green)">
            <i class="bi bi-cash-stack"></i>
        </div>
        <div>
            <div class="stat-label">Total Pending Value</div>
            <div class="stat-sub">Combined amount</div>
        </div>
        <div class="stat-value">&#8369;@totalAmount.ToString("N0")</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-bg);color:var(--blue)">
            <i class="bi bi-funnel"></i>
        </div>
        <div>
            <div class="stat-label">Showing</div>
            <div class="stat-sub">Filtered results</div>
        </div>
        <div class="stat-value">@Model.Expenses.Count</div>
    </div>
</div>

<!-- Filters -->
<div class="sc">
    <div class="sc-body">
        <form method="get" asp-action="PendingExpenses" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="fc-label">Search</label>
                <div class="input-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@Model.SearchTerm"
                           class="fc-input" placeholder="Employee, type or plate…" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="fc-label">Date From</label>
                <input type="date" name="dateFrom" class="fc-input" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="fc-label">Date To</label>
                <input type="date" name="dateTo" class="fc-input" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-f btn-main flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
                <a asp-action="PendingExpenses" class="btn-f btn-clear"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Records -->
<div class="sc">
    <div class="sc-head">
        <h6 class="sc-title"><i class="bi bi-hourglass-split"></i> Expenses Pending Review</h6>
        @if (Model.PendingCount > 0)
        {
            <span class="st st-pend">@Model.PendingCount pending</span>
        }
    </div>

    @if (!Model.Expenses.Any())
    {
        <div class="empty-box">
            <i class="bi bi-check2-all"></i>
            <h6>All Caught Up!</h6>
            <p class="mb-0">No pending expenses match your current filters.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto">
            <table class="ex-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Employee</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Vehicle</th>
                        <th>Amount</th>
                        <th>Expense Date</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th style="text-align:center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Expenses)
                    {
                        var name = e.User?.FullName ?? e.User?.UserName ?? "Unknown";
                        var dept = e.User?.Department ?? "—";
                        var initial = name[0].ToString().ToUpper();

                        <tr>
                            <td class="muted-sm">@e.Id</td>
                            <td>
                                <div class="emp-cell">
                                    <div class="user-avatar-sm">@initial</div>
                                    <div>
                                        <div class="emp-name">@name</div>
                                        <div class="emp-dept">@dept</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="desc-cell" title="@e.Description">@e.Description</span></td>
                            <td><span class="type-badge">@e.ExpenseType</span></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(e.PlateNumber))
                                {
                                    <span class="muted-sm">—</span>
                                }
                                else
                                {
                                    <span class="plate-chip">@e.PlateNumber</span>
                                }
                            </td>
                            <td class="amt">&#8369;@e.Amount.ToString("N2")</td>
                            <td class="muted-sm">@e.ExpenseDate.ToString("MMM d, yyyy")</td>
                            <td class="muted-sm">@e.DateSubmitted.ToString("MMM d, yyyy")</td>
                            <td><span class="st st-pend"><i class="bi bi-hourglass-split"></i> Pending</span></td>
                            <td>
                                <div class="act-group">
                                    <a asp-controller="Supervisor" asp-action="Details" asp-route-id="@e.Id" class="act act-view">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <button type="button" class="act act-approve"
                                            data-bs-toggle="modal" data-bs-target="#approveModal"
                                            data-expense-id="@e.Id">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                    <button type="button" class="act act-reject"
                                            data-bs-toggle="modal" data-bs-target="#rejectModal"
                                            data-expense-id="@e.Id">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="sc-foot">
            <span>@Model.Expenses.Count expense(s) shown</span>
            <span style="font-family:'Familjen Grotesk',sans-serif;font-weight:700;font-size:.92rem;color:var(--ink)">
                Total: &#8369;@totalAmount.ToString("N2")
            </span>
        </div>
    }
</div>

<!-- ══ Modal: Approve ══ -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content pm-modal" method="post" id="approveForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h6 class="modal-title">Approve Expense <span id="approveIdLabel"></span></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p style="font-size:.84rem;color:var(--muted);margin-bottom:.9rem">
                    This expense will be forwarded to the Department Head.
                </p>
                <label class="fc-label">Remarks (optional)</label>
                <textarea name="remarks" class="fc-input" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-f btn-clear" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn-f btn-green"><i class="bi bi-check-lg"></i> Approve</button>
            </div>
        </form>
    </div>
</div>

<!-- ══ Modal: Reject ══ -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content pm-modal" method="post" id="rejectForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h6 class="modal-title">Reject Expense <span id="rejectIdLabel"></span></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="fc-label">Reason category</label>
                <input type="text" name="rejectionReason" class="fc-input mb-3"
                       placeholder="e.g. Missing receipt" maxlength="100" />
                <label class="fc-label">Remarks <span style="color:var(--red)">*</span></label>
                <textarea name="remarks" class="fc-input" rows="3" required
                          placeholder="Explain why this expense is rejected"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-f btn-clear" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn-f btn-red"><i class="bi bi-x-lg"></i> Reject</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('approveModal')?.addEventListener('show.bs.modal', function (e) {
            const id = e.relatedTarget.dataset.expenseId;
            document.getElementById('approveForm').action = '/Supervisor/Approve/' + id;
            document.getElementById('approveIdLabel').textContent = '#' + id;
        });
        document.getElementById('rejectModal')?.addEventListener('show.bs.modal', function (e) {
            const id = e.relatedTarget.dataset.expenseId;
            document.getElementById('rejectForm').action = '/Supervisor/Reject/' + id;
            document.getElementById('rejectIdLabel').textContent = '#' + id;
        });
        document.getElementById('approveModal')?.addEventListener('hidden.bs.modal', function () {
            document.getElementById('approveForm').reset();
        });
        document.getElementById('rejectModal')?.addEventListener('hidden.bs.modal', function () {
            document.getElementById('rejectForm').reset();
        });
    </script>
}